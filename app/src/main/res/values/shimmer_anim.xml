<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- One place to define the premium shimmer look. The shimmer_anim drawable
         uses these tokens so we get the same gradient highlight across the
         splash screen, chat skeleton, and loading state — no fluorescent
         green, no jittery indeterminate spinner, just the same sleek gray
         sweep you'd see in Stripe / Linear / Notion mobile shells. -->
    <color name="shimmer_base">#1F2937</color>
    <color name="shimmer_highlight">#334155</color>
    <color name="shimmer_track">#0F172A</color>

    <integer name="shimmer_duration_ms">900</integer>
    <integer name="shimmer_corner_radius_dp">12</integer>
</resources>
