<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════ TYPOGRAPHY ══════════════ -->
    <style name="Text.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/type_display</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/type_headline</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Text.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/type_title</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">@dimen/type_subtitle</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Text.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Text.BodyMuted" parent="Text.Body">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">@dimen/type_body_sm</item>
    </style>
    <style name="Text.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">@dimen/type_caption</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="Text.Overline" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">@dimen/type_label</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="Text.SectionTitle" parent="Text.Title">
        <item name="android:textSize">@dimen/type_subtitle</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="Text.Amount" parent="Text.Title">
        <item name="android:textSize">@dimen/type_amount</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.AmountXL" parent="Text.Title">
        <item name="android:textSize">@dimen/type_amount_xl</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="Text.HeroLabel" parent="Text.Overline">
        <item name="android:textColor">@color/hero_text_muted</item>
    </style>
    <style name="Text.HeroAmount" parent="Text.Amount">
        <item name="android:textColor">@color/hero_text</item>
    </style>

    <!-- ══════════════ BUTTONS ══════════════ -->
    <style name="BtnBase" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">@dimen/type_subtitle</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="BtnPrimary" parent="BtnBase">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>
    <style name="BtnSuccess" parent="BtnBase">
        <item name="backgroundTint">@color/success</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="BtnDanger" parent="BtnBase">
        <item name="backgroundTint">@color/danger</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="BtnOutline" parent="BtnBase">
        <item name="backgroundTint">@color/bg_card</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="BtnGhost" parent="BtnBase">
        <item name="backgroundTint">@color/surface_2</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="BtnText" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textSize">@dimen/type_body_sm</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="BtnChipFilter" parent="BtnGhost">
        <item name="android:textSize">@dimen/type_caption</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="cornerRadius">999dp</item>
    </style>

    <!-- ══════════════ CARDS ══════════════ -->
    <style name="CardBase" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="CardSurface" parent="CardBase" />
    <style name="CardSoft" parent="CardBase">
        <item name="cardCornerRadius">@dimen/radius_md</item>
    </style>
    <style name="CardElevated" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardElevation">@dimen/elevation_2</item>
        <item name="cardCornerRadius">@dimen/radius_lg</item>
    </style>
    <style name="CardStat" parent="CardBase">
        <item name="cardCornerRadius">@dimen/radius_md</item>
    </style>

    <!-- Legacy alias kept -->
    <style name="StatCard" parent="CardStat" />

    <!-- ══════════════ INPUTS ══════════════ -->
    <style name="Widget.ExpenseOS.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">@dimen/type_body</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:minHeight">@dimen/input_height</item>
    </style>
    <style name="InputBox" parent="">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/type_body</item>
    </style>
    <style name="InputBoxEditText" parent="InputBox">
        <item name="android:textColorHint">@color/text_hint</item>
    </style>
    <style name="FieldLabel" parent="Text.Overline">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:layout_marginBottom">@dimen/space_2</item>
    </style>
    <style name="SearchField" parent="InputBox">
        <item name="android:background">@drawable/bg_search_field</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:minHeight">46dp</item>
    </style>
    <style name="SpinnerField" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:minHeight">@dimen/input_height</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <!-- ══════════════ CHIPS / BADGES / PILLS ══════════════ -->
    <style name="FilterChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:layout_marginEnd">@dimen/space_2</item>
        <item name="android:background">@drawable/selector_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">@dimen/type_caption</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FilterChipStyle" parent="FilterChip" />

    <style name="Badge" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_default_badge</item>
        <item name="android:paddingHorizontal">9dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:textSize">@dimen/type_label</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="Badge.Income">
        <item name="android:background">@drawable/bg_badge_income</item>
        <item name="android:textColor">@color/income_badge_text</item>
    </style>
    <style name="Badge.Expense">
        <item name="android:background">@drawable/bg_badge_expense</item>
        <item name="android:textColor">@color/expense_badge_text</item>
    </style>
    <style name="Badge.Warning">
        <item name="android:background">@drawable/bg_badge_warning</item>
        <item name="android:textColor">@color/warning</item>
    </style>
    <style name="Badge.Primary">
        <item name="android:background">@drawable/bg_chip_suggestion</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="Pill" parent="Badge">
        <item name="android:background">@drawable/bg_stat_pill</item>
    </style>

    <!-- ══════════════ LISTS / STRUCTURE ══════════════ -->
    <style name="ListRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/selector_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">@dimen/space_4</item>
        <item name="android:paddingVertical">@dimen/space_3</item>
    </style>
    <style name="TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/topbar_height</item>
        <item name="android:background">@color/nav_bg</item>
        <item name="android:elevation">@dimen/elevation_1</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/space_3</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">@dimen/touch_target</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="IconTile" parent="">
        <item name="android:layout_width">@dimen/icon_tile</item>
        <item name="android:layout_height">@dimen/icon_tile</item>
        <item name="android:background">@drawable/bg_icon_tile_primary</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/divider</item>
    </style>
    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingVertical">6dp</item>
    </style>
    <style name="NavLabel" parent="Text.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <style name="DrawerItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingHorizontal">@dimen/space_4</item>
    </style>
    <style name="DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/type_subtitle</item>
    </style>

    <!-- ══════════════ STATES ══════════════ -->
    <style name="EmptyStateIcon" parent="">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:alpha">0.75</item>
    </style>
    <style name="EmptyStateTitle" parent="Text.Subtitle">
        <item name="android:layout_marginTop">@dimen/space_4</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="EmptyStateBody" parent="Text.BodyMuted">
        <item name="android:layout_marginTop">@dimen/space_1</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="SkeletonBar" parent="">
        <item name="android:background">@drawable/bg_skeleton</item>
    </style>
</resources>
