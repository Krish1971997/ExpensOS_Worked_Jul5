<?xml version="1.0" encoding="utf-8"?>
<!-- activity_home.xml — app shell: top bar + bottom nav + side drawer.
     Every ID referenced by HomeActivity.java is preserved. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ═══════════ MAIN CONTENT ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            style="@style/TopBar"
            android:paddingEnd="@dimen/space_2">

            <ImageButton
                android:id="@+id/btnHamburger"
                style="@style/IconButton"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu"
                app:tint="@color/text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_1">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ExpenseOS" />

                <TextView
                    android:id="@+id/tvBookTitle"
                    style="@style/Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCalendarView"
                style="@style/IconButton"
                android:contentDescription="Calendar view"
                android:src="@drawable/ic_calendar_check" />
        </LinearLayout>

        <!-- Fragment host -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Bottom navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_nav_height"
            android:background="@color/nav_bg"
            android:elevation="@dimen/elevation_2"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                style="@style/NavItem"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/navHomeIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_book" 
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/navHomeLabel"
                    style="@style/NavLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cashbooks"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navLog"
                style="@style/NavItem"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/navLogIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_log" />

                <TextView
                    android:id="@+id/navLogLabel"
                    style="@style/NavLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navBackup"
                style="@style/NavItem"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/navBackupIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_scheduler" />

                <TextView
                    android:id="@+id/navBackupLabel"
                    style="@style/NavLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scheduler"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navConfig"
                style="@style/NavItem"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/navConfigIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_settings_gradient" />

                <TextView
                    android:id="@+id/navConfigLabel"
                    style="@style/NavLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="@color/text_muted" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════ SIDE DRAWER ═══════════ -->
    <LinearLayout
        android:id="@+id/sideDrawer"
        android:layout_width="284dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/bg_card"
        android:orientation="vertical">

        <!-- Drawer header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_card_hero"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/space_5">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ExpenseOS"
                android:textColor="@color/hero_text"
                android:textSize="@dimen/type_headline" />

            <TextView
                android:id="@+id/drawerBookName"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hero_text_muted" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_2">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_4"
                    android:paddingTop="@dimen/space_2"
                    android:paddingBottom="@dimen/space_1"
                    android:text="Workspace" />

                <LinearLayout
                    android:id="@+id/drawerBooks"
                    style="@style/DrawerItem">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="📒"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Cash Books" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerSettings"
                    style="@style/DrawerItem">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_configuration" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Configuration" />
                </LinearLayout>

                <View style="@style/Divider" />

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_4"
                    android:paddingTop="@dimen/space_2"
                    android:paddingBottom="@dimen/space_1"
                    android:text="Money" />

                <LinearLayout
                    android:id="@+id/drawerBudget"
                    style="@style/DrawerItem">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_budget" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Budget" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerConfigureBudget"
                    style="@style/DrawerItem">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="🧮"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Configure Budget" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerMonthlyReport"
                    style="@style/DrawerItem">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="📈"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Monthly Category Report" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerSequence"
                    style="@style/DrawerItem">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="🔢"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Sequence" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerBulkAdd"
                    style="@style/DrawerItem">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="➕"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Bulk Add" />
                </LinearLayout>

                <View style="@style/Divider" />

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/space_4"
                    android:paddingTop="@dimen/space_2"
                    android:paddingBottom="@dimen/space_1"
                    android:text="Data &amp; tools" />

                <LinearLayout
                    android:id="@+id/drawerAudit"
                    style="@style/DrawerItem">

                    <TextView
                        android:layout_width="26dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="📋"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Audit Log" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerScheduler"
                    style="@style/DrawerItem">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_backup" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Backup" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerRecycleBin"
                    style="@style/DrawerItem">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_recycle_bin" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="Recycle Bin" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/drawerSqlConsole"
                    style="@style/DrawerItem">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sql_console" />

                    <TextView
                        style="@style/Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_3"
                        android:text="SQL Console" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_6"
                    android:background="@android:color/transparent" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
