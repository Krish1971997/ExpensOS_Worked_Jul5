<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Type accent capsule: red = expense, green = income -->
    <View
        android:id="@+id/viewPrevTypeBadge"
        android:layout_width="6dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp" />

    <TextView
        android:id="@+id/tvPrevIndex"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp">

        <!-- Row 1: Category / SubCategory / Payment chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPrevCategory"
                style="@style/Badge.Primary"
                android:text="" />

            <TextView
                android:id="@+id/tvPrevSubCategory"
                style="@style/Badge.Warning"
                android:layout_marginStart="@dimen/space_1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvPrevPayment"
                style="@style/Badge"
                android:layout_marginStart="@dimen/space_1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Row 2: Note (left) + Amount (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPrevNote"
                style="@style/Text.BodyMuted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tvPrevAmount"
                style="@style/Text.Amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_2"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Row 3: date/time + attachments -->
        <TextView
            android:id="@+id/tvPrevMeta"
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textColor="@color/text" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="8dp"
        android:alpha="0.3"
        android:background="@color/text_muted" />

    <TextView
        android:id="@+id/btnPrevDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_input_box"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="🗑"
        android:textSize="18sp" />
</LinearLayout>