<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_input_box"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etAiKeyValue"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="API Key"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnAiKeyToggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Show/hide key"
            android:src="@drawable/ic_visibility" />

        <ImageButton
            android:id="@+id/btnAiKeyEdit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Edit key"
            android:src="@drawable/ic_edit" />

        <ImageButton
            android:id="@+id/btnAiKeyRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove key"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <EditText
        android:id="@+id/etAiKeyDesc"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@null"
        android:hint="Description (e.g. test@gmail.com)"
        android:importantForAutofill="no"
        android:inputType="text"
        android:singleLine="true"
        android:textSize="12sp" />
</LinearLayout>
