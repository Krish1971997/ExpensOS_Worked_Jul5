<?xml version="1.0" encoding="utf-8"?>
<!-- Timesheet edit dialog — theme-token colours + design-system field styles. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingTop="@dimen/space_2"
        android:paddingEnd="@dimen/space_6"
        android:paddingBottom="@dimen/space_2">

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Project" />

        <TextView
            android:id="@+id/tvEdProject"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_2" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task" />

        <Spinner
            android:id="@+id/spEdTask"
            style="@style/SpinnerField"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height" />

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="Activity" />

        <Spinner
            android:id="@+id/spEdActivity"
            style="@style/SpinnerField"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_1"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdDate"
                    style="@style/BtnOutline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:textSize="@dimen/type_body_sm"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_1"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hours (H.MM)" />

                <EditText
                    android:id="@+id/etEdHours"
                    style="@style/InputBoxEditText"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:background="@drawable/bg_glass_input"
                    android:digits="0123456789.,"
                    android:inputType="text"
                    android:maxLength="5" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="Description" />

        <EditText
            android:id="@+id/etEdDesc"
            style="@style/InputBoxEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_input"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:paddingTop="12dp"
            android:paddingBottom="12dp" />
    </LinearLayout>
</ScrollView>
