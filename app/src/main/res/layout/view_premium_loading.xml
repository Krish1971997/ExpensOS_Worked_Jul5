<?xml version="1.0" encoding="utf-8"?>
<!-- Premium cold-start loader: brand mark + indeterminate ring + shimmer line.
     Shown over the shell while the app initialises, then faded out. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/premiumLoadingOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ExpenseOS"
            android:textColor="@color/primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoaderStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Preparing your books…"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="18dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary" />

        <View
            android:layout_width="120dp"
            android:layout_height="4dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_shimmer_pill" />
    </LinearLayout>
</FrameLayout>
