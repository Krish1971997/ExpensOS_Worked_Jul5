<?xml version="1.0" encoding="utf-8"?>
<!-- activity_global_search.xml — one box that searches screens/pages,
     masters (books, categories, payment types, …) and transaction data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/nav_bg"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/btnGlobalSearchBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text"
            android:textSize="22sp" />

        <EditText
            android:id="@+id/etGlobalSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:hint="Search screens, masters, transactions…"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnGlobalSearchClear"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSearchSummary"
        style="@style/Text.BodyMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/space_4"
        android:paddingTop="@dimen/space_3"
        android:text="Type to search across screens, masters (books, categories, payment types) and transactions."
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_6" />

    <TextView
        android:id="@+id/tvSearchEmpty"
        style="@style/Text.BodyMuted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_6"
        android:text="Type to search."
        android:visibility="gone" />
</LinearLayout>
