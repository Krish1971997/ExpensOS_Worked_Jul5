<?xml version="1.0" encoding="utf-8"?>
<!-- activity_timesheet.xml — rebuilt on the ExpenseOS glass design system.
     No hardcoded colours: every value comes from values/colors.xml and
     values-night/colors.xml, so light + dark mode both render correctly.
     Window background (aurora_bg) shows through the transparent root. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ── Top bar (same TopBar style as the rest of the app) ── -->
        <LinearLayout
            style="@style/TopBar"
            android:paddingEnd="@dimen/space_2">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/IconButton"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_1">

                <TextView
                    style="@style/Text.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Odoo" />

                <TextView
                    style="@style/Text.Subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Timesheet" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbBusy"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/svMain"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/llContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <!-- ── Entry form ── -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/CardBase"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_4">

                        <TextView
                            style="@style/FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Project" />

                        <Spinner
                            android:id="@+id/spProject"
                            style="@style/SpinnerField"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/FieldLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="0dp"
                                android:layout_weight="1"
                                android:text="Task" />

                            <CheckBox
                                android:id="@+id/cbShowDone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/primary"
                                android:paddingEnd="2dp"
                                android:text="Show Done"
                                android:textColor="@color/text_muted"
                                android:textSize="@dimen/type_caption" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/spTask"
                            style="@style/SpinnerField"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height" />

                        <TextView
                            style="@style/FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:text="Activity" />

                        <Spinner
                            android:id="@+id/spActivity"
                            style="@style/SpinnerField"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="@dimen/space_1"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/FieldLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Date" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnDate"
                                    style="@style/BtnOutline"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/input_height"
                                    android:textSize="@dimen/type_body_sm"
                                    app:cornerRadius="12dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_1"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/FieldLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hours (H.MM)" />

                                <EditText
                                    android:id="@+id/etHours"
                                    style="@style/InputBoxEditText"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/input_height"
                                    android:background="@drawable/bg_glass_input"
                                    android:digits="0123456789.,"
                                    android:hint="2.30"
                                    android:inputType="text"
                                    android:maxLength="5" />

                                <TextView
                                    android:id="@+id/tvHoursHint"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:minHeight="16dp"
                                    android:textColor="@color/text_muted"
                                    android:textSize="@dimen/type_caption" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            style="@style/FieldLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_3"
                            android:text="Description" />

                        <EditText
                            android:id="@+id/etDesc"
                            style="@style/InputBoxEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_input"
                            android:gravity="top|start"
                            android:hint="What did you work on?"
                            android:inputType="textMultiLine|textCapSentences"
                            android:minLines="3"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSave"
                            style="@style/BtnPrimary"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="@dimen/space_4"
                            android:text="Save Timesheet"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ── Day summary ── -->
                <TextView
                    style="@style/Text.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:layout_marginBottom="@dimen/space_2"
                    android:text="Day summary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/CardStat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="@dimen/space_1"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_3">

                            <TextView
                                style="@style/Text.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Attendance"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tvAttNet"
                                style="@style/Text.AmountXL"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvAttInfo"
                                style="@style/Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Loading..." />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/CardStat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_1"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_3">

                            <TextView
                                style="@style/Text.Overline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Logged"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tvTsTotal"
                                style="@style/Text.AmountXL"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-"
                                android:textColor="@color/primary"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tvTsInfo"
                                style="@style/Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Loading..." />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ── Entries header ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Timesheets on this date" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopy"
                        style="@style/BtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="Copy" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefresh"
                        style="@style/BtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="Refresh" />
                </LinearLayout>

                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_2"
                    android:text="Tap an entry to edit it (project cannot be changed)." />

                <LinearLayout
                    android:id="@+id/llEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_6" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
