<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Banner (tinted with the task colour, like the Google Calendar header art) -->
    <View
        android:id="@+id/vPreviewBanner"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="@color/primary" />

    <!-- Rounded sheet overlapping the banner -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="190dp"
        android:background="@drawable/bg_preview_sheet"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <View
                    android:id="@+id/vPreviewColor"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tvPreviewName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="26sp" />
            </LinearLayout>

            <!-- date/time, description, events, reminders, … rows are added in code -->
            <LinearLayout
                android:id="@+id/previewRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <!-- Floating circle buttons -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_preview_circle_btn"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@android:color/white" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPreviewEdit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_preview_circle_btn"
            android:src="@android:drawable/ic_menu_edit"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/btnPreviewMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_preview_circle_btn"
            android:src="@drawable/ic_more_vert"
            android:tint="@android:color/white" />
    </LinearLayout>
</FrameLayout>
