<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btn_clear_console"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="🗑 Clear"
            android:textSize="12sp"
            android:backgroundTint="#C0392B"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btn_copy_console"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="📋 Copy"
            android:textSize="12sp"
            android:backgroundTint="#1565C0"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll_console"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_console_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No logs yet. Start a sync to see output here.\n" />
    </ScrollView>
</LinearLayout>