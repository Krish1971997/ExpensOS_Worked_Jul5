<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- Navbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/nav_bg"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📈 ExpenseOS"
            android:textColor="@color/primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRestoreCloud"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="☁ Restore"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnAllTxn"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:text="📊 All Txns"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Middle content: header, search, book list -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Page header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📒 Cash Books"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select a book to start tracking"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNewBook"
                style="@style/BtnPrimary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="+ New Book"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Search + Sort bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/nav_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <EditText
                android:id="@+id/etBookSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:hint="Search books…"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/btnBookSort"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sort books"
                android:padding="6dp"
                android:src="@drawable/ic_sort"
                android:tint="@color/primary" />
        </LinearLayout>

        <!-- Book list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBooks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Bottom nav — Android standard: 4 top-level tabs.
         Cashbooks / Stats / AI Bot / More (PassBook, Food Tracker,
         Integrations, All Txns, Restore live in the "More" sheet). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:background="@color/nav_bg"
        android:elevation="@dimen/elevation_2"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navCashbooks"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navCashbooksIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_book"
                app:tint="@color/primary" />

            <TextView
                android:id="@+id/navCashbooksLabel"
                style="@style/NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cashbooks"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStats"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navStatsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_stats"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/navStatsLabel"
                style="@style/NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stats"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAiAssistant"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navAiIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ai"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/navAiAssistantLabel"
                style="@style/NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Bot"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMore"
            style="@style/NavItem">

            <ImageView
                android:id="@+id/navMoreIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_more"
                app:tint="@color/text_muted" />

            <TextView
                android:id="@+id/navMoreLabel"
                style="@style/NavLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="More"
                android:textColor="@color/text_muted" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
