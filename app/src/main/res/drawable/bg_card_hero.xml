<?xml version="1.0" encoding="utf-8"?>
<!-- Glass hero: translucent blue→violet gradient + hairline light border.
     Light mode-la deep tone (white text-ku contrast), dark mode-la vivid. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/hero_grad_start"
                android:endColor="@color/hero_grad_end"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/glass_stroke_soft" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
