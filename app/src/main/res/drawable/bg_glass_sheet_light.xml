<?xml version="1.0" encoding="utf-8"?>
<!-- Light glass sheet for programmatic sheets that draw their own dark text —
     keeps text readable in BOTH light and dark mode (frosted-light sheet). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F2FFFFFF" />
    <stroke android:width="1dp" android:color="@color/glass_stroke_soft" />
    <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
</shape>
